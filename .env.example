# Public Worker origin. Required for production deployments; no Worker hostname is assumed.
VITE_API_BASE=http://localhost:8787
# Public OpenAPI document URL used by Scalar. Hosted releases must pin an exact compatible backend SHA.
VITE_OPENAPI_URL=https://raw.githubusercontent.com/benhammoush/iris-backend/main/openapi.yaml
# Enable non-sensitive emergency display fixtures only when intentionally needed.
VITE_ENABLE_FIXTURES=false
